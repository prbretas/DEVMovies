{
  "name": "devmovies",
  "version": "1.0.0",
  "description": "A web platform for discovering movies, series, animes, games and online TV content",
  "main": "index.html",
  "scripts": {
    "start": "python -m http.server 8000",
    "dev": "python -m http.server 8000",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\"",
    "build": "echo 'Static site - no build needed'",
    "analyze": "npm run lint && npm run test:coverage"
  },
  "keywords": [
    "movies",
    "series",
    "animes",
    "games",
    "streaming",
    "entertainment"
  ],
  "author": "DEVMovies Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prbretas/DEVMovies.git"
  },
  "bugs": {
    "url": "https://github.com/prbretas/DEVMovies/issues"
  },
  "homepage": "https://prbretas.github.io/DEVMovies/",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
