# DEVMovies Environment Variables
# Copie este arquivo para .env e adicione suas credenciais

# ============================================
# API Keys (Obtenha em RapidAPI)
# ============================================

# IMDB API
# Obtenha em: https://rapidapi.com/SAdrian/api/imdb-top-100-movies
VITE_IMDB_API_KEY=sua_chave_api_aqui
VITE_IMDB_HOST=imdb-top-100-movies.p.rapidapi.com

# Deezer API  
# Obtenha em: https://rapidapi.com/deezerdevs/api/deezer-1
VITE_DEEZER_API_KEY=sua_chave_api_aqui
VITE_DEEZER_HOST=deezerdevs-deezer.p.rapidapi.com

# ============================================
# Ambiente e Debug
# ============================================

# Ambiente: development, staging, production
VITE_ENV=development

# Debug mode
VITE_DEBUG=true

# ============================================
# API Configuration
# ============================================

# Timeout para requisições (ms)
VITE_API_TIMEOUT=10000

# Retry attempts
VITE_API_RETRY_ATTEMPTS=3

# Cache TTL (ms)
VITE_CACHE_TTL=3600000

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. NUNCA comite este arquivo com valores reais
# 2. Sempre use .env.example para exemplo
# 3. Adicione .env ao .gitignore
# 4. Copie .env.example para .env localmente
# 5. Componha API keys em https://rapidapi.com
# 6. Para produção, use GitHub Secrets
#
# Estrutura de GitHub Secret para CI/CD:
# - VITE_IMDB_API_KEY
# - VITE_DEEZER_API_KEY
# - etc
